# External OpenAI-compatible model API for generated experiments (optional).
# This does not configure or start Codex. Replace the example URL only in your
# local .env, and never put real credentials in this tracked example file.
LLM_API_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Weights & Biases experiment tracking (optional; leave empty unless an
# experiment explicitly uses W&B).
WANDB_API_KEY=
WANDB_PROJECT=

# External database connection (optional; leave empty unless an experiment
# explicitly requires a database). A real connection URL may contain secrets.
DATABASE_URL=
